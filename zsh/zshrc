# WSL doesn't export COLORTERM even when the host terminal (e.g. Windows Terminal) supports true color.
export COLORTERM="${COLORTERM:-truecolor}"

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"

plugins=(git)

source $ZSH/oh-my-zsh.sh

zstyle ':completion:*' menu select

[[ -f ~/.aliases.zsh ]] && source ~/.aliases.zsh
[[ -f ~/.local.sh ]] && source ~/.local.sh

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# if local/bin exists, add it to PATH
if [[ -d "$HOME/.local/bin" ]]; then
  export PATH="$PATH:$HOME/.local/bin"
fi

eval "$(fzf --zsh)"
eval "$(direnv hook zsh)"

# Optional plugins: enabled only if found (oh-my-zsh custom dir or system package).
# zsh-syntax-highlighting must be sourced last.
_source_if_found() {
  local name="$1" script="$2" path
  for path in \
    "${ZSH_CUSTOM:-$ZSH/custom}/plugins/$name/$script" \
    "/usr/share/$name/$script" \
    "/usr/local/share/$name/$script"; do
    [[ -r "$path" ]] && source "$path" && return
  done
}
_source_if_found zsh-autosuggestions zsh-autosuggestions.zsh
_source_if_found zsh-syntax-highlighting zsh-syntax-highlighting.zsh
unset -f _source_if_found

eval "$(atuin init zsh --disable-up-arrow)"
eval "$(zoxide init zsh --cmd cd)"
