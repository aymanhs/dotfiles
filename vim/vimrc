" This is used to zoom in or out by changing the font size
function! Zoom(delta)
    let f = &guifont
    let s = strpart(f, stridx(f, ":h")+2, 2)
    if a:delta == 0
        let s = 12
    else
        let s += a:delta
    endif
    let newfont = "Consolas:h" . s . ":cANSI"
    let &guifont=newfont
endfunction

noremap <C-kPlus> :call Zoom(1)<CR>
noremap <C-kMinus> :call Zoom(-1)<CR>
noremap <C-k0> :call Zoom(0)<CR>

if has('win32') || has('win64')
    call Zoom(0)
endif


